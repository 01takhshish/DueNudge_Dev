# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
APP_URL=http://localhost:3000            # public URL of the Next.js app
WEB_PORT=3000                            # port the Next.js dev/start server binds
API_PUBLIC_URL=http://localhost:4000     # public URL of the API (OAuth callbacks)
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
# Owner role: runs migrations, owns tables (bypasses RLS — never used by the app at runtime)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/duenudge
# App role: what the API and workers connect as. NOBYPASSRLS — row-level security is enforced.
DATABASE_APP_URL=postgres://duenudge_app:app_password@localhost:5433/duenudge
DATABASE_POOL_MAX=10

# ─── Redis / queues ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
# 32+ random bytes, base64. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false                       # true in production (HTTPS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
STRIPE_TRIAL_DAYS=14

# ─── Email ───────────────────────────────────────────────────────────────────
EMAIL_FROM="DueNudge <no-reply@duenudge.local>"
RESEND_API_KEY=                           # production: Resend
SMTP_URL=smtp://localhost:1025            # development: Mailpit (docker compose)

# ─── AI (reminder drafting) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ─── File storage (tenant logos) — S3 or Cloudflare R2 ───────────────────────
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=                              # R2: https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=                       # public CDN/base URL for uploaded objects

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Web (Next.js) ───────────────────────────────────────────────────────────
API_URL=http://localhost:4000             # server-side base URL the Next app uses to reach the API
NEXT_PUBLIC_APP_NAME=DueNudge
